# Server Port Configuration
PORT=3000

# Server Environment (development | production | test)
NODE_ENV=production

# Optional: Path to custom yt-dlp binary (if not auto-detected or in PATH)
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Optional: Base64 or Netscape format YouTube Cookies content for age-restricted / private video downloads
# YOUTUBE_COOKIES=
