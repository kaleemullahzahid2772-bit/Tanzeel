{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["public/**"]
            }
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(.*\\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff2?))",
            "dest": "/public/$1",
            "headers": {
                "cache-control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/(sw\\.js)",
            "dest": "/public/sw.js",
            "headers": {
                "cache-control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/(manifest\\.json|robots\\.txt|sitemap\\.xml)",
            "dest": "/public/$1",
            "headers": {
                "cache-control": "public, max-age=3600"
            }
        },
        {
            "src": "/(.*)",
            "dest": "/server.js"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" }
            ]
        }
    ]
}
