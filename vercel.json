{
  "version": 2,
  "functions": {
    "server.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    },
    "api/**/*.js": {
      "includeFiles": "public/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
