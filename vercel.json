{
    "version": 2,
    "builds": [
        {
            "src": "server.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": ["public/**"]
            }
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        { "src": "/sw.js", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0" }, "dest": "/public/sw.js" },
        { "src": "/manifest.json", "headers": { "Cache-Control": "no-cache, no-store, must-revalidate, max-age=0" }, "dest": "/public/manifest.json" },
        { "src": "/robots.txt", "dest": "/public/robots.txt" },
        { "src": "/sitemap.xml", "dest": "/public/sitemap.xml" },
        { "src": "/og-image.svg", "dest": "/public/og-image.svg" },
        { "src": "/logo.png", "dest": "/public/logo.png" },
        { "src": "/logo.jpg", "dest": "/public/logo.jpg" },
        { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
        { "src": "/icons/(.*)", "dest": "/public/icons/$1" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/server.js" }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "DENY" }
            ]
        }
    ]
}
